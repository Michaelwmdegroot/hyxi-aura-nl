# Store real values only in Hostinger environment variables or a local ignored .env.
NODE_ENV=production
PORT=3000
SITE_URL=https://hyxi-aura.nl
# Include your exact temporary HTTPS Hostinger origin while testing, if needed.
ALLOWED_ORIGINS=
CANONICAL_REDIRECT=true
# Keep false unless the hosting proxy sanitizes X-Forwarded-For and has one hop.
TRUST_PROXY=false

# Requests remain safely disabled until this is true AND SMTP is fully configured.
LEAD_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Plain authorized sender address (not a display name). Must match your mailbox setup.
SMTP_FROM=
LEAD_TO=info@thuisbatterijteam.nl
SMTP_DAILY_LIMIT=100
LEAD_RATE_LIMIT=6
# Optional: a random secret of at least 32 characters. Never commit the real value.
CSRF_SECRET=
