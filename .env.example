# Store real values only in Hostinger environment variables or a local ignored .env.
NODE_ENV=production
PORT=3000
SITE_URL=https://hyxi-aura.nl
# Include your exact temporary HTTPS Hostinger origin while testing, if needed.
ALLOWED_ORIGINS=
CANONICAL_REDIRECT=true
# Keep false unless the hosting proxy sanitizes X-Forwarded-For and has one hop.
TRUST_PROXY=false

# Requests remain safely disabled until this is true AND SMTP is fully configured.
LEAD_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Plain authorized sender address (not a display name). Must match your mailbox setup.
SMTP_FROM=
LEAD_TO=leads@thuisbatterijteam.nl
SMTP_DAILY_LIMIT=100
LEAD_RATE_LIMIT=6
# Optional: a random secret of at least 32 characters. Never commit the real value.
CSRF_SECRET=

# V2 DATABASE (leave LEAD_STORAGE_MODE=mail on live until staging + migration
# + recovery tests are complete; do not fill passwords in Git!)
LEAD_STORAGE_MODE=mail
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Generate with: openssl rand -base64 32
LEAD_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
LEAD_HASH_SECRET=

# ADMIN (one password, no MFA; needs database mode and 001–004 migrations)
ADMIN_ENABLED=false
# Generate independently with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
