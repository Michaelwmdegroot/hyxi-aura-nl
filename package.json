{
  "name": "hyxi-aura-nl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactieve HYXI AURA productervaring en adviesaanvragen voor Thuisbatterij Team.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/content.mjs && vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "node scripts/check.mjs",
    "dev:qa": "node tests/preview-dev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "vite": "^8.3.8"
  }
}
