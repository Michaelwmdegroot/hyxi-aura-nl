{
  "name": "hyxi-aura-nl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactieve HYXI AURA productervaring en adviesaanvragen voor Thuisbatterij Team.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/content.mjs && vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "node scripts/check.mjs",
    "dev:qa": "node tests/preview-dev.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs --apply",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs",
    "test:db": "node tests/mysql-integration.mjs && node tests/admin-integration.mjs && node tests/admin-accounts-integration.mjs && node tests/admin-operations-integration.mjs && node tests/notification-budget-integration.mjs && node tests/schema-integration.mjs",
    "db:admin-migrate": "node --env-file-if-exists=.env scripts/db-admin-migrate.mjs --apply",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-bootstrap.mjs --create-first-owner",
    "test:beheer": "node tests/beheer-browser.mjs",
    "db:account-migrate": "node --env-file-if-exists=.env scripts/db-account-migrate.mjs --apply",
    "db:notification-migrate": "node --env-file-if-exists=.env scripts/db-notification-migrate.mjs --apply",
    "db:prepare": "node --env-file-if-exists=.env scripts/db-prepare.mjs --apply",
    "admin:manage": "node --env-file-if-exists=.env scripts/admin-manage.mjs --manage-accounts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "vite": "^8.3.8",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0"
  }
}
