# HYXI AURA Beheer — ADDITIONS to the existing Hostinger environment only.
# Keep the working SMTP_*, LEAD_ENABLED, LEAD_TO, CSRF_SECRET and SITE_URL.
# Fill these values privately in Hostinger or an ignored private .env.
# Preparation leaves the existing public mail route active.
LEAD_STORAGE_MODE=mail
ADMIN_ENABLED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=REPLACE_WITH_FULL_HOSTINGER_DATABASE_NAME
DB_USER=REPLACE_WITH_FULL_HOSTINGER_DATABASE_USER
DB_PASSWORD=REPLACE_PRIVATELY_WITH_DATABASE_PASSWORD

# Generate three independent values; retain a secure backup of every key.
# openssl rand -base64 32
LEAD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_VALUE
# openssl rand -hex 32
LEAD_HASH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
# openssl rand -hex 32
ADMIN_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET

# Only AFTER schema, owner login, backup/restore and end-to-end verification:
# LEAD_STORAGE_MODE=database
# ADMIN_ENABLED=true
